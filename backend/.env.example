
# ==========================================
# SLEEP CYCLE - Backend Configuration
# ==========================================

# Application Settings
PROJECT_NAME="Sleep Cycle API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
DEBUG=False

# Security & JWT Authentication
# Set a strong, randomly generated secret in your private .env file.
SECRET_KEY="replace_with_a_secure_random_secret"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration
# Local SQLite database for development.
DATABASE_URL="sqlite:///./sleepcycle.db"

# Supabase Configuration
# Add your actual credentials only in backend/.env.
SUPABASE_URL=""
SUPABASE_KEY=""

# AI Sleep Coach Configuration
# Providers: neuro_science, openai, gemini, anthropic
AI_PROVIDER="neuro_science"
AI_API_KEY=""

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173","http://127.0.0.1:5173","http://127.0.0.1:4173"]
